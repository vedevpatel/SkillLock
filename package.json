{
  "name": "skilllock",
  "version": "0.1.0",
  "description": "git diff for what your Agent Skills touch. A deterministic static authority-diff engine.",
  "keywords": [
    "agent-skills",
    "claude",
    "authority",
    "lockfile",
    "diff",
    "static-analysis"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "skilllock": "dist/cli/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "golden": "npm run build && UPDATE_GOLDEN=1 vitest run",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "gray-matter": "^4.0.3",
    "ignore": "^5.3.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
